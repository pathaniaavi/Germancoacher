// German Vocabulary Coach — data model
// Two-sided competence: every word carries an independent RECOGNITION and PRODUCTION
// spaced-repetition state. "Mastered" requires both. See src/core/srs for the engine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Article {
  DER
  DIE
  DAS
  NONE
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  ARTICLE
  NUMERAL
  INTERJECTION
  PHRASE
  OTHER
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum WordStatus {
  ACTIVE
  ARCHIVED
  MASTERED
}

enum SentenceKind {
  SIMPLE
  REAL_LIFE
  CLOZE
}

enum SentenceSource {
  USER
  AI
}

enum ReviewDimension {
  RECOGNITION
  PRODUCTION
}

enum Rating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ReviewMode {
  FLASHCARD
  TYPING
  SENTENCE
  CLOZE
  DIFFICULT
}

enum PracticeMode {
  FLASHCARD
  TYPING
  SENTENCE_BUILD
  CLOZE
  WRITE_OWN
}

// ---------------------------------------------------------------------------
// Auth.js (next-auth v5) models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts         Account[]
  authSessions     Session[]
  settings         UserSettings?
  words            VocabularyWord[]
  tags             Tag[]
  reviewSessions   ReviewSession[]
  reviewResults    ReviewResult[]
  practiceAttempts PracticeAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// App models
// ---------------------------------------------------------------------------

model UserSettings {
  id                String  @id @default(cuid())
  userId            String  @unique
  dailyReviewLimit  Int     @default(30)
  newCardsPerDay    Int     @default(10)
  theme             String  @default("system") // "light" | "dark" | "system"
  aiEnabled         Boolean @default(true)
  aiModel           String  @default("claude-opus-4-8")
  // User-supplied Anthropic key. Stored server-side, never returned raw to the client.
  // NOTE: plaintext for the MVP — encrypt at rest before any multi-tenant deployment.
  anthropicApiKey   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VocabularyWord {
  id              String       @id @default(cuid())
  userId          String
  word            String
  translation     String
  article         Article      @default(NONE)
  plural          String?
  partOfSpeech    PartOfSpeech @default(OTHER)
  level           CefrLevel    @default(A1)
  notes           String?      @db.Text
  pronunciationHint String?
  status          WordStatus   @default(ACTIVE)
  // Learning-path topic this word belongs to (e.g. "Food & Drink"). Free-form so AI-generated
  // and custom topics both fit; the curriculum config supplies the recommended ordering.
  topic           String?

  // --- Recognition SRS state (meaning / article / plural) ---
  recognitionEase           Float     @default(2.5)
  recognitionIntervalDays   Float     @default(0)
  recognitionReps           Int       @default(0)
  recognitionLapses         Int       @default(0)
  recognitionLearningStep   Int       @default(0)
  recognitionDueAt          DateTime?
  recognitionLastReviewedAt DateTime?

  // --- Production SRS state (use the word in a sentence) ---
  productionEase           Float     @default(2.5)
  productionIntervalDays   Float     @default(0)
  productionReps           Int       @default(0)
  productionLapses         Int       @default(0)
  productionLearningStep   Int       @default(0)
  productionDueAt          DateTime?
  productionLastReviewedAt DateTime?

  // --- Derived scores (0..100) ---
  recognitionScore Int @default(0)
  productionScore  Int @default(0)
  masteryScore     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags             Tag[]             @relation("WordTags")
  exampleSentences ExampleSentence[]
  reviewResults    ReviewResult[]
  practiceAttempts PracticeAttempt[]

  @@index([userId, status])
  @@index([userId, recognitionDueAt])
  @@index([userId, productionDueAt])
  @@index([userId, masteryScore])
  @@index([userId, partOfSpeech])
  @@index([userId, level])
  @@index([userId, topic])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  words VocabularyWord[] @relation("WordTags")

  @@unique([userId, name])
}

model ExampleSentence {
  id         String         @id @default(cuid())
  wordId     String
  kind       SentenceKind
  textDe     String         @db.Text
  textEn     String?        @db.Text
  // For CLOZE: the answer token and its character offset in textDe.
  clozeAnswer String?
  clozeStart  Int?
  source     SentenceSource @default(USER)
  createdAt  DateTime       @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model ReviewSession {
  id        String     @id @default(cuid())
  userId    String
  mode      ReviewMode @default(FLASHCARD)
  startedAt DateTime   @default(now())
  endedAt   DateTime?
  cardCount Int        @default(0)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  results ReviewResult[]

  @@index([userId, startedAt])
}

model ReviewResult {
  id           String          @id @default(cuid())
  sessionId    String
  userId       String
  wordId       String
  dimension    ReviewDimension
  rating       Rating
  prevInterval Float
  nextInterval Float
  prevEase     Float
  nextEase     Float
  answeredAt   DateTime        @default(now())

  session ReviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word    VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, answeredAt])
  @@index([userId, answeredAt])
}

model PracticeAttempt {
  id          String       @id @default(cuid())
  userId      String
  wordId      String
  mode        PracticeMode @default(WRITE_OWN)
  userSentence String      @db.Text
  // AI verdict stored as JSON: { isCorrect, score, grammarFeedback, vocabFeedback, naturalAlternative }
  aiVerdict   Json?
  score       Int?         // 0..100, mirrored from aiVerdict for indexing
  createdAt   DateTime     @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([wordId, createdAt])
}
