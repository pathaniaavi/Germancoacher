# --- Database (PostgreSQL) ---
# Local dev example; swap for your managed Postgres URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/german_vocab_coach?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
# Base URL of the app (Auth.js v5)
AUTH_URL="http://localhost:3000"

# Email provider (magic-link). Use a real SMTP server in production.
# For local dev you can use a service like Mailtrap or run a dev SMTP.
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="German Vocab Coach <no-reply@example.com>"

# --- Anthropic (Claude) ---
# Server-side only. Never expose to the client.
ANTHROPIC_API_KEY=""
# Optional model override. Defaults to claude-opus-4-8.
# Cheaper option: claude-haiku-4-5-20251001
ANTHROPIC_MODEL="claude-opus-4-8"
